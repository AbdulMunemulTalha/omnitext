# Copy to .env on the server and fill in. Never commit the real .env.
NODE_ENV=production
PUBLIC_URL=https://heyquicky.com
DOMAIN=heyquicky.com

# Meta app "Quicky" (App settings → Basic)
META_APP_ID=1472241481412452
META_APP_SECRET=
# Any random string; enter the same one when the webhook is set up.
# Create one with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Facebook Login for Business → Configurations (optional for Messenger/Instagram, required for WhatsApp)
META_LOGIN_CONFIG_ID=
META_WHATSAPP_CONFIG_ID=

# 64 hex characters. Create once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Back it up: if it is lost every channel must be connected again.
TOKEN_ENCRYPTION_KEY=

# Shown on /privacy, /terms and /data-deletion
OPERATOR_NAME=Quicky
SUPPORT_EMAIL=codepanthrer@gmail.com
